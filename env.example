# Wzór konfiguracji. Skopiuj do .env i uzupełnij:
#
#     cp .env.example .env
#
# .env NIE trafia do repozytorium ani do obrazu (patrz .gitignore
# i .dockerignore) — to jedyne miejsce z sekretami tego wdrożenia.


# ====================================================================
#  WYMAGANE
# ====================================================================

# Klucz podpisujący sesje i tokeny CSRF. Bez niego aplikacja nie
# wstanie przy wyłączonym DEBUG-u — i tak ma być. Wygeneruj własny:
#
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Podmiana klucza wylogowuje wszystkich, więc raz ustawiony zostaje.
DJANGO_SECRET_KEY=


# ====================================================================
#  ADRESY
# ====================================================================

# Domeny, pod którymi aplikacja odpowiada — po przecinku, bez schematu.
# 127.0.0.1 i localhost dopisują się same (potrzebuje ich sonda stanu).
DJANGO_ALLOWED_HOSTS=accur8pool.pl,www.accur8pool.pl

# Adresy, z których przyjmowane są formularze — TU ze schematem.
# Po włączeniu certyfikatu zostaw same wersje https.
DJANGO_CSRF_TRUSTED_ORIGINS=https://accur8pool.pl,https://www.accur8pool.pl


# ====================================================================
#  TRYB PRACY
# ====================================================================

# 1 włącza tryb programisty: strony błędów z tracebackiem i ciasteczka
# działające po http. NIGDY na serwerze dostępnym z internetu.
DJANGO_DEBUG=0

# Poziom logów: DEBUG, INFO, WARNING, ERROR.
DJANGO_LOG_LEVEL=INFO


# ====================================================================
#  HTTPS
# ====================================================================

# Przekierowanie http → https. Zostaw 1, gdy aplikacja stoi za proxy
# kończącym TLS; ustaw 0, gdy proxy przekierowuje już samo (inaczej
# przekierowania są dwa).
DJANGO_SECURE_SSL_REDIRECT=1

# HSTS — przeglądarka zapamiętuje, że z tą domeną rozmawia wyłącznie po
# https. WŁĄCZAJ DOPIERO, gdy certyfikat działa i nie planujesz odwrotu:
# przez podany czas (31536000 = rok) nie da się tego cofnąć u tych, którzy
# już nagłówek dostali. 0 = wyłączone.
DJANGO_SECURE_HSTS_SECONDS=0


# ====================================================================
#  BAZA DANYCH
# ====================================================================

# sqlite (domyślnie) albo postgres.
#
# SQLite wystarcza: w bazie są tylko konta, nazwy zestawów i segmenty —
# pomiary leżą w plikach CSV na wolumenie. Plik bazy ląduje w
# ACCUR8POOL_DATA_ROOT, czyli tam gdzie dane, więc backup jest jeden.
DB_ENGINE=sqlite

# --- tylko dla DB_ENGINE=postgres ---
# Uruchomienie z bazą w Compose:  docker compose --profile postgres up -d
#DB_NAME=accur8pool
#DB_USER=accur8pool
#DB_PASSWORD=
#DB_HOST=db
#DB_PORT=5432


# ====================================================================
#  DANE
# ====================================================================

# Korzeń dla raw_data, prepared_data i pliku SQLite. W kontenerze to
# punkt montowania wolumenu — zmieniaj tylko razem z docker-compose.yml.
ACCUR8POOL_DATA_ROOT=/data


# ====================================================================
#  GUNICORN
# ====================================================================

# Liczba procesów roboczych. Puste = 2 × liczba rdzeni + 1. Każdy worker
# to osobna kopia pandas/numpy w pamięci, więc na małej maszynie warto
# wpisać 2 lub 3 ręcznie.
#GUNICORN_WORKERS=

# Ile sekund worker może liczyć jedno żądanie. Upload dużego CSV idzie
# razem z przygotowaniem danych, stąd domyślne 300 zamiast 30.
#GUNICORN_TIMEOUT=300


# ====================================================================
#  PIERWSZE URUCHOMIENIE (opcjonalne)
# ====================================================================

# Podanie obu wartości zakłada konto administratora przy starcie —
# tylko jeśli konta o tej nazwie jeszcze nie ma, więc restart nie
# nadpisze zmienionego hasła. Po pierwszym logowaniu zakomentuj.
#DJANGO_SUPERUSER_USERNAME=admin
#DJANGO_SUPERUSER_EMAIL=admin@accur8pool.pl
#DJANGO_SUPERUSER_PASSWORD=
